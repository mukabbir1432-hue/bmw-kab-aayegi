{
  "name": "bmw-kab-aayegi-backend",
  "version": "2.0.0",
  "description": "Backend server for BMW Kab Aayegi? — Free BMW affordability calculator with admin dashboard, referral system, and WhatsApp lead capture",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "BMW Kab Aayegi? Team",
    "email": "hello@bmwkabayegi.in",
    "url": "https://bmwkabayegi.in"
  },
  "homepage": "https://bmwkabayegi.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-username/bmw-kab-aayegi.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/bmw-kab-aayegi/issues",
    "email": "hello@bmwkabayegi.in"
  },
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
    "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "lint": "echo \"No linter configured\" && exit 0",
    "audit": "npm audit --production",
    "audit:fix": "npm audit fix",
    "outdated": "npm outdated",
    "clean": "rm -rf node_modules package-lock.json",
    "reinstall": "npm run clean && npm install",
    "prestart": "node -e \"console.log('Starting BMW Kab Aayegi? backend...')\"",
    "postinstall": "node -e \"console.log('Install complete. Run: npm start')\""
  },
    "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "mongoose": "^8.2.0",
    "pino": "^8.19.0",
    "pino-http": "^9.0.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "pino-pretty": "^10.3.1"
  },
  "keywords": [
    "bmw",
